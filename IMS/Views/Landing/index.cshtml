@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <title>سیستم مدیریت یکپارچه - صدرا تجهیز مهرگان</title>
    <link rel="stylesheet" href="~/css/landingpage.css" />

</head>
<body>
    <div class="app-container">
        <!-- هدر با رنگ primary-color -->
        <header class="app-header system-header" style="background-color: #1a4a5a;">
            <div class="app-brand">
                <img src="~/image/logo.png" alt="Logo" class="app-logo system-logo">
                <div class="brand-info">
                    <h1 style="color: white; font-size: 1.3rem; margin: 0; background: none;">صدرا تجهیز مهرگان</h1>
                    <p style="color: #e0f7fa; font-size: 0.8rem; margin: 0;">سیستم مدیریت یکپارچه</p>
                </div>
            </div>
            <div class="app-actions">
                <div class="version-badge" style="background-color: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.1);">نسخه ۱.۱.۰</div>
                <a href="/Login/Index" class="login-btn access-btn" style="background-color: #1aada2; color: white;">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>ورود به سامانه</span>
                </a>
            </div>
        </header>

        <!-- بخش اصلی -->
        <main class="app-main">
            <!-- نوار کناری -->
            <aside class="app-sidebar">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">ماژول‌های سیستم</h3>
                    <ul class="module-list">
                        <li class="module-item">
                            <a href="#overview" class="module-link active" data-section="overview">
                                <div class="module-icon">
                                    <i class="fas fa-home"></i>
                                </div>
                                <div class="module-info">
                                    <h4>نمای کلی</h4>
                                    <p>آشنایی با سیستم</p>
                                </div>
                            </a>
                        </li>
                        <li class="module-item">
                            <a href="#modules" class="module-link" data-section="modules">
                                <div class="module-icon">
                                    <i class="fas fa-cogs"></i>
                                </div>
                                <div class="module-info">
                                    <h4>ماژول‌ها</h4>
                                    <p>بخش‌های مختلف سیستم</p>
                                </div>
                            </a>
                        </li>

                        <li class="module-item">
                            <a href="#guide" class="module-link" data-section="guide">
                                <div class="module-icon">
                                    <i class="fas fa-book"></i>
                                </div>
                                <div class="module-info">
                                    <h4>راهنما</h4>
                                    <p>آموزش استفاده</p>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h3 class="sidebar-title">وضعیت سیستم</h3>
                    <div class="quick-stats">
                        <div class="stat-item">
                            <div class="stat-value">۴</div>
                            <div class="stat-label">ماژول</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">۲۴/۷</div>
                            <div class="stat-label">دسترسی</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">۱۰۰٪</div>
                            <div class="stat-label">پشتیبانی</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">۱.۱.۰</div>
                            <div class="stat-label">نسخه</div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- محتوای اصلی -->
            <div class="app-content">
                <!-- بخش نمای کلی -->
                <section id="overview" class="content-section active-section">
                    <div class="section-header">
                        <div>
                            <h2 class="section-title">سیستم مدیریت یکپارچه</h2>
                            <p class="section-subtitle">سامانه تخصصی تدارکات، حسابداری، انبارداری و پروژه‌های شرکت</p>
                        </div>
                    </div>

                    <div class="system-overview">
                        <div class="overview-text">
                            <p>سیستم مدیریت مالی صدرا تجهیز مهرگان، یک پلتفرم یکپارچه برای مدیریت تمامی فرآیندهای مالی، حسابداری، انبارداری و پروژه‌های شرکت است. این سیستم به صورت اختصاصی برای نیازهای شرکت طراحی و توسعه داده شده است.</p>

                            <div class="features-grid">
                                <div class="feature-item">
                                    <i class="fas fa-check-circle"></i>
                                    <span>یکپارچگی کامل با فرآیندهای شرکت</span>
                                </div>
                                <div class="feature-item">
                                    <i class="fas fa-check-circle"></i>
                                    <span>امنیت بالا و دسترسی سطح‌بندی شده</span>
                                </div>
                                <div class="feature-item">
                                    <i class="fas fa-check-circle"></i>
                                    <span>گزارش‌گیری پیشرفته و تحلیل داده‌ها</span>
                                </div>
                                <div class="feature-item">
                                    <i class="fas fa-check-circle"></i>
                                    <span>پشتیبانی فنی و به‌روزرسانی مستمر</span>
                                </div>
                            </div>
                        </div>

                        <div class="login-prompt">
                            <h3>آماده شروع هستید؟</h3>
                            <p>برای دسترسی به تمامی امکانات سیستم، وارد حساب کاربری خود شوید.</p>
                            <a href="/Login/Index" class="primary-btn access-btn">
                                <i class="fas fa-sign-in-alt"></i>
                                ورود به سیستم
                            </a>
                        </div>
                    </div>
                </section>

                <!-- بخش ماژول‌ها -->
                <section id="modules" class="content-section" style="display: none;">
                    <div class="section-header">
                        <div>
                            <h2 class="section-title">ماژول‌های سیستم</h2>
                            <p class="section-subtitle">آشنایی با بخش‌های مختلف سیستم</p>
                        </div>
                    </div>

                    <div class="modules-display">
                        <div class="module-card accounting">
                            <i class="fas fa-calculator"></i>
                            <h3>حسابداری مالی</h3>
                            <p>سیستم جامع حسابداری برای ثبت، کنترل و تحلیل تمامی تراکنش‌های مالی شرکت</p>
                        </div>

                        <div class="module-card inventory">
                            <i class="fas fa-warehouse"></i>
                            <h3>انبارداری</h3>
                            <p>مدیریت کامل انبار و موجودی کالاها با قابلیت پیگیری دقیق</p>
                        </div>

                        <div class="module-card projects">
                            <i class="fas fa-project-diagram"></i>
                            <h3>مدیریت پروژه</h3>
                            <p>پیگیری و مدیریت پروژه‌های شرکت با قابلیت کنترل هزینه و زمان</p>
                        </div>

                        <div class="module-card procurement">
                            <i class="fas fa-truck"></i>
                            <h3>تدارکات</h3>
                            <p>سیستم مدیریت فرآیند خرید و تأمین کالا و خدمات</p>
                        </div>
                    </div>
                </section>

                <!-- بخش راهنما -->
                <section id="guide" class="content-section" style="display: none;">
                    <div class="section-header">
                        <div>
                            <h2 class="section-title">راهنمای استفاده</h2>
                            <p class="section-subtitle">دستورالعمل‌ها و آموزش‌های ضروری</p>
                        </div>
                    </div>

                    <div class="dashboard-grid">
                        <div class="dashboard-card">
                            <i class="fas fa-user-shield"></i>
                            <h4>امنیت و دسترسی</h4>
                            <p>هر کاربر با نام کاربری و رمز عبور منحصر به فرد به سیستم دسترسی دارد.</p>
                        </div>

                        <div class="dashboard-card">
                            <i class="fas fa-file-export"></i>
                            <h4>گزارش‌گیری</h4>
                            <p>گزارش‌ها به صورت PDF و Excel قابل دریافت هستند.</p>
                        </div>

                        <div class="dashboard-card">
                            <i class="fas fa-headset"></i>
                            <h4>پشتیبانی فنی</h4>
                            <p>در صورت بروز مشکل با واحد فناوری اطلاعات تماس بگیرید.</p>
                        </div>

                        <div class="dashboard-card">
                            <i class="fas fa-download"></i>
                            <h4>نصب و راه‌اندازی</h4>
                            <p>سیستم نیاز به نصب خاصی ندارد و از طریق مرورگر قابل دسترسی است.</p>
                        </div>
                    </div>
                </section>
            </div>
        </main>

        <!-- فوتر با رنگ primary-color -->
        <footer class="app-footer system-footer">
            <div class="footer-info">
                <span>© ۱۴۰۴ - استفاده داخلی شرکت صدرا تجهیز مهرگان</span>
                <span class="footer-contact">
                    <i class="fas fa-phone"></i>
                    پشتیبانی: داخلی ۱۰۲
                </span>
            </div>
            <div>
                <span>it-support@sedratezh.com</span>
            </div>
        </footer>
    </div>

    <!-- دکمه تغییر تم (جهت هماهنگی با استایل دوم) -->
    <div class="theme-toggle">
        <i class="fas fa-sun"></i>
        <i class="fas fa-moon"></i>
        <div class="toggle-thumb"></div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // مدیریت کلیک روی منوها
            const menuLinks = document.querySelectorAll('.module-link');
            const sections = document.querySelectorAll('.content-section');

            menuLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();

                    // حذف کلاس active از همه لینک‌ها
                    menuLinks.forEach(l => l.classList.remove('active'));

                    // اضافه کردن کلاس active به لینک فعلی
                    this.classList.add('active');

                    // مخفی کردن همه بخش‌ها
                    sections.forEach(section => {
                        section.style.display = 'none';
                        section.classList.remove('active-section');
                    });

                    // نمایش بخش مربوطه
                    const targetId = this.getAttribute('href').substring(1);
                    const targetSection = document.getElementById(targetId);
                    if (targetSection) {
                        targetSection.style.display = 'block';
                        setTimeout(() => {
                            targetSection.classList.add('active-section');
                        }, 10);
                    }
                });
            });

            // تنظیمات لوگو
            const logo = document.querySelector('.app-logo');
            if (logo) {
                logo.style.maxHeight = '50px';
                logo.style.width = 'auto';
            }

            // اسکرول نرم برای محتوای اصلی
            const contentArea = document.querySelector('.app-content');
            if (contentArea) {
                contentArea.addEventListener('wheel', function(e) {
                    this.scrollTop += e.deltaY;
                });
            }

            // نمایش اولیه
            const activeSection = document.querySelector('.active-section');
            if (activeSection) {
                activeSection.style.display = 'block';
            }

            // مدیریت تغییر تم
            const themeToggle = document.querySelector('.theme-toggle');
            const body = document.body;

            themeToggle.addEventListener('click', function() {
                body.classList.toggle('dark-mode');
            });
        });
    </script>
</body>
</html>