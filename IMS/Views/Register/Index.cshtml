@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ثبت‌نام در سیستم | پنل کاربری</title>

    <!-- استایل شخصی -->
    <link rel="stylesheet" href="~/css/RegisterStyle.css" />

    <style>
        /* استایل اضطراری برای فونت */
        * {
            font-family: Vazirmatn, Tahoma, Arial, sans-serif !important;
        }

        /* تأیید اعتبار رمز عبور */
        #passwordMatchText {
            font-size: 0.8rem;
            margin-top: 5px;
            min-height: 18px;
        }

        .password-match {
            color: #28a745;
        }

        .password-mismatch {
            color: #dc3545;
        }

        /* بهبود ظاهر فیلدهای ورودی */
        .input-container.focused .form-input {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(0, 180, 219, 0.2);
        }

      
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- پس‌زمینه دکوراتیو -->
        <div class="background-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
            <div class="shape shape-4"></div>
        </div>

        <!-- کانتینر اصلی -->
        <div class="login-container">
            <!-- کارت ثبت‌نام -->
            <div class="login-card">
                <!-- هدر -->
                <div class="login-header">
                    <div class="logo-section">
                        <img src="~/image/logo.png" alt="Logo" class="logo">
                    </div>

                    <div class="welcome-section">
                        <h2 class="login-title">
                            <i class="fas fa-user-plus"></i>
                            ثبت‌نام در سیستم
                        </h2>
                        <p class="login-subtitle">لطفاً اطلاعات خود را برای ایجاد حساب کاربری وارد کنید</p>
                    </div>
                </div>

                <!-- فرم ثبت‌نام -->
                <form action="/register" method="POST" class="login-form" id="registerForm">
                    <!-- ردیف اول: نام و نام خانوادگی -->
                    <div class="form-row">
                        <!-- فیلد نام -->
                        <div class="form-group">
                            <label for="firstName" class="form-label">
                                <i class="fas fa-user"></i>
                                نام
                            </label>
                            <div class="input-container">
                                <input type="text"
                                       id="firstName"
                                       name="firstName"
                                       placeholder="نام خود را وارد کنید"
                                       class="form-input"
                                       required
                                       autocomplete="given-name">
                            </div>
                        </div>

                        <!-- فیلد نام خانوادگی -->
                        <div class="form-group">
                            <label for="lastName" class="form-label">
                                <i class="fas fa-user-friends"></i>
                                نام خانوادگی
                            </label>
                            <div class="input-container">
                                <input type="text"
                                       id="lastName"
                                       name="lastName"
                                       placeholder="نام خانوادگی خود را وارد کنید"
                                       class="form-input"
                                       required
                                       autocomplete="family-name">
                            </div>
                        </div>
                    </div>

                    <!-- فیلد نام کاربری -->
                    <div class="form-group">
                        <label for="username" class="form-label">
                            <i class="fas fa-user-circle"></i>
                            نام کاربری
                        </label>
                        <div class="input-container">
                            <input type="text"
                                   id="username"
                                   name="username"
                                   placeholder="نام کاربری دلخواه خود را وارد کنید"
                                   class="form-input"
                                   required
                                   autocomplete="username">
                        </div>
                        <div class="hint-text">نام کاربری باید حداقل ۴ کاراکتر باشد</div>
                    </div>

                    <!-- فیلد شماره تلفن -->
                    <div class="form-group">
                        <label for="phone" class="form-label">
                            <i class="fas fa-phone"></i>
                            شماره تلفن
                        </label>
                        <div class="input-container">
                            <input type="tel"
                                   id="phone"
                                   name="phone"
                                   placeholder="0912XXXXXXX"
                                   class="form-input"
                                   autocomplete="tel">
                        </div>
                    </div>

                    <!-- ردیف دوم: رمز عبور و تأیید رمز -->
                    <div class="form-row">
                        <!-- فیلد رمز عبور -->
                        <div class="form-group">
                            <label for="password" class="form-label">
                                <i class="fas fa-lock"></i>
                                کلمه عبور
                            </label>
                            <div class="input-container">
                                <input type="password"
                                       id="password"
                                       name="password"
                                       placeholder="رمز عبور خود را وارد کنید"
                                       class="form-input"
                                       required
                                       autocomplete="new-password">
                                <button type="button" class="toggle-password" id="togglePassword" aria-label="نمایش رمز عبور">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="password-strength">
                                <div class="strength-meter" id="strengthMeter"></div>
                            </div>
                            <div class="strength-text" id="strengthText">قدرت رمز: ضعیف</div>
                        </div>

                        <!-- فیلد تأیید رمز عبور -->
                        <div class="form-group">
                            <label for="confirmPassword" class="form-label">
                                <i class="fas fa-lock"></i>
                                تأیید کلمه عبور
                            </label>
                            <div class="input-container">
                                <input type="password"
                                       id="confirmPassword"
                                       name="confirmPassword"
                                       placeholder="رمز عبور را مجدداً وارد کنید"
                                       class="form-input"
                                       required
                                       autocomplete="new-password">
                                <button type="button" class="toggle-password" id="toggleConfirmPassword" aria-label="نمایش رمز عبور">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div id="passwordMatchText" class="hint-text"></div>
                        </div>
                    </div>

                    <!-- دکمه ثبت‌نام -->
                    <button type="submit" class="cta-btn" id="registerBtn">
                        <span class="btn-text">ثبت‌نام در سیستم</span>
                        <i class="fas fa-user-plus btn-icon"></i>
                    </button>

                    <!-- لودر هنگام ثبت‌نام -->
                    <div class="loader" id="submitLoader">
                        <div class="spinner"></div>
                        <span>در حال ایجاد حساب کاربری...</span>
                    </div>
                </form>

                <!-- لینک ورود -->
                <div class="login-section">
                    <div class="login-text">
                        <span>قبلاً حساب کاربری دارید؟</span>
                        <a href="/login" class="login-link">
                            <i class="fas fa-sign-in-alt"></i>
                            وارد شوید
                        </a>
                    </div>
                </div>

                <!-- اطلاعیه -->
                <div class="notification" id="notification">
                    <i class="fas fa-check-circle"></i>
                    <span class="notification-text"></span>
                </div>
            </div>
        </div>
    </div>

    <script>
        // DOM Elements
        const registerForm = document.getElementById('registerForm');
        const togglePassword = document.getElementById('togglePassword');
        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const registerBtn = document.getElementById('registerBtn');
        const submitLoader = document.getElementById('submitLoader');
        const notification = document.getElementById('notification');
        const strengthMeter = document.getElementById('strengthMeter');
        const strengthText = document.getElementById('strengthText');
        const passwordMatchText = document.getElementById('passwordMatchText');

        // Toggle Password Visibility
        togglePassword.addEventListener('click', function () {
            const icon = this.querySelector('i');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.className = 'fas fa-eye-slash';
                this.setAttribute('aria-label', 'مخفی کردن رمز عبور');
            } else {
                passwordInput.type = 'password';
                icon.className = 'fas fa-eye';
                this.setAttribute('aria-label', 'نمایش رمز عبور');
            }
        });

        // Toggle Confirm Password Visibility
        toggleConfirmPassword.addEventListener('click', function () {
            const icon = this.querySelector('i');
            if (confirmPasswordInput.type === 'password') {
                confirmPasswordInput.type = 'text';
                icon.className = 'fas fa-eye-slash';
                this.setAttribute('aria-label', 'مخفی کردن رمز عبور');
            } else {
                confirmPasswordInput.type = 'password';
                icon.className = 'fas fa-eye';
                this.setAttribute('aria-label', 'نمایش رمز عبور');
            }
        });

    

        // Check Password Match
        function checkPasswordMatch() {
            const password = passwordInput.value;
            const confirmPassword = confirmPasswordInput.value;

            if (!confirmPassword) {
                passwordMatchText.textContent = '';
                confirmPasswordInput.classList.remove('error', 'success');
                return;
            }

            if (password === confirmPassword) {
                passwordMatchText.textContent = '✓ رمزهای عبور مطابقت دارند';
                passwordMatchText.className = 'password-match';
                confirmPasswordInput.classList.remove('error');
                confirmPasswordInput.classList.add('success');
            } else {
                passwordMatchText.textContent = '✗ رمزهای عبور مطابقت ندارند';
                passwordMatchText.className = 'password-mismatch';
                confirmPasswordInput.classList.remove('success');
                confirmPasswordInput.classList.add('error');
            }
        }

        // Event Listeners for Password Fields
        passwordInput.addEventListener('input', function () {
            checkPasswordStrength(this.value);
            checkPasswordMatch();
        });

        confirmPasswordInput.addEventListener('input', checkPasswordMatch);

        // Input Focus Effects
        document.querySelectorAll('.form-input').forEach(input => {
            const container = input.parentElement;

            input.addEventListener('focus', function () {
                container.classList.add('focused');
            });

            input.addEventListener('blur', function () {
                if (!this.value.trim()) {
                    container.classList.remove('focused');
                }
            });

            // Add initial state
            if (input.value.trim()) {
                container.classList.add('focused');
            }
        });

        // Form Validation
        function validateForm() {
            let isValid = true;
            const firstName = document.getElementById('firstName');
            const lastName = document.getElementById('lastName');
            const username = document.getElementById('username');
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');

            // Clear previous errors
            document.querySelectorAll('.error-message').forEach(el => el.remove());
            document.querySelectorAll('.form-input').forEach(el => el.classList.remove('error'));

            // First Name validation
            if (!firstName.value.trim()) {
                showError(firstName, 'لطفاً نام را وارد کنید');
                isValid = false;
            } else if (firstName.value.trim().length < 2) {
                showError(firstName, 'نام باید حداقل ۲ کاراکتر باشد');
                isValid = false;
            }

            // Last Name validation
            if (!lastName.value.trim()) {
                showError(lastName, 'لطفاً نام خانوادگی را وارد کنید');
                isValid = false;
            } else if (lastName.value.trim().length < 2) {
                showError(lastName, 'نام خانوادگی باید حداقل ۲ کاراکتر باشد');
                isValid = false;
            }

            // Username validation
            if (!username.value.trim()) {
                showError(username, 'لطفاً نام کاربری را وارد کنید');
                isValid = false;
            } else if (username.value.trim().length < 4) {
                showError(username, 'نام کاربری باید حداقل ۴ کاراکتر باشد');
                isValid = false;
            }

            // Password validation
            if (!password.value.trim()) {
                showError(password, 'لطفاً رمز عبور را وارد کنید');
                isValid = false;
            } else if (password.value.trim().length < 6) {
                showError(password, 'رمز عبور باید حداقل ۶ کاراکتر باشد');
                isValid = false;
            } else if (checkPasswordStrength(password.value) < 2) {
                showError(password, 'رمز عبور بسیار ضعیف است');
                isValid = false;
            }

            // Confirm Password validation
            if (!confirmPassword.value.trim()) {
                showError(confirmPassword, 'لطفاً تأیید رمز عبور را وارد کنید');
                isValid = false;
            } else if (password.value !== confirmPassword.value) {
                showError(confirmPassword, 'رمزهای عبور مطابقت ندارند');
                isValid = false;
            }

            return isValid;
        }

        function showError(input, message) {
            input.classList.add('error');

            const errorDiv = document.createElement('div');
            errorDiv.className = 'error-message';
            errorDiv.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${message}`;
            errorDiv.style.marginTop = '5px';

            input.parentElement.parentElement.appendChild(errorDiv);
        }

        // Show Notification
        function showNotification(message, type = 'success') {
            const icon = notification.querySelector('i');
            const text = notification.querySelector('.notification-text');

            notification.style.background = type === 'success' ? '#28a745' : '#dc3545';
            icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
            text.textContent = message;

            notification.classList.add('show');

            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }

        // Form Submission
        registerForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            if (!validateForm()) {
                return;
            }

            // Show loading state
            registerBtn.style.display = 'none';
            submitLoader.style.display = 'flex';

            // Simulate API call
            try {
                const formData = {
                    firstName: document.getElementById('firstName').value,
                    lastName: document.getElementById('lastName').value,
                    username: document.getElementById('username').value,
                    phone: document.getElementById('phone').value,
                    password: document.getElementById('password').value
                };

                // Simulate API delay
                await new Promise(resolve => setTimeout(resolve, 2000));

                // Show success message
                showNotification('ثبت‌نام با موفقیت انجام شد!', 'success');

                // Redirect to login page after delay
                setTimeout(() => {
                    window.location.href = '/login';
                }, 2500);

            } catch (error) {
                showNotification('خطا در ثبت‌نام. لطفاً مجدداً تلاش کنید.', 'error');

                // Reset form state
                registerBtn.style.display = 'flex';
                submitLoader.style.display = 'none';
            }
        });

        // Phone number formatting
        const phoneInput = document.getElementById('phone');
        phoneInput.addEventListener('input', function () {
            let value = this.value.replace(/\D/g, '');

            if (value.length > 0) {
                if (value.startsWith('0')) {
                    value = value.substring(1);
                }

                if (value.length > 10) {
                    value = value.substring(0, 10);
                }

                // Format: XXX XXX XXXX
                const parts = [];
                if (value.length > 0) parts.push(value.substring(0, 3));
                if (value.length > 3) parts.push(value.substring(3, 6));
                if (value.length > 6) parts.push(value.substring(6));

                this.value = parts.join(' ');
            }
        });

        // Username availability check
        const usernameInput = document.getElementById('username');
        usernameInput.addEventListener('input', function () {
            const username = this.value.trim();
            if (username.length >= 4) {
                // Simulate username check
                const takenUsernames = ['admin', 'user', 'test', 'admin123'];
                const isTaken = takenUsernames.includes(username.toLowerCase());

                if (isTaken) {
                    showError(usernameInput, 'این نام کاربری قبلاً ثبت شده است');
                }
            }
        });

        // Add keyboard shortcuts
        document.addEventListener('keydown', function (e) {
            // Ctrl + Enter to submit form
            if (e.ctrlKey && e.key === 'Enter') {
                registerForm.dispatchEvent(new Event('submit'));
            }
        });

        // Initialize form
        document.addEventListener('DOMContentLoaded', function() {
            submitLoader.style.display = 'none';
        });
    </script>
</body>
</html>