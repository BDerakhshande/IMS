@model IMS.Controllers.RegisterController.RegisterVm

@{
    Layout = "_LoginRegisterLayout";
    ViewData["Title"] = "ثبت‌نام در سیستم";
}

<form action="/register" method="POST" class="login-form" id="registerForm">
    @Html.AntiForgeryToken()

    <div class="form-row">
        <div class="form-group">
            <label for="firstName" class="form-label">
                <i class="fas fa-user"></i>
                نام
            </label>
            <div class="input-container">
                <input type="text"
                       id="firstName"
                       name="FirstName"
                       placeholder="نام خود را وارد کنید"
                       class="form-input @((!ViewData.ModelState.IsValid && ViewData.ModelState["FirstName"]?.Errors.Any() == true) ? "error" : "")"
                       required
                       autocomplete="given-name"
                       value="@Model?.FirstName" />
            </div>
        </div>

        <div class="form-group">
            <label for="lastName" class="form-label">
                <i class="fas fa-user-friends"></i>
                نام خانوادگی
            </label>
            <div class="input-container">
                <input type="text"
                       id="lastName"
                       name="LastName"
                       placeholder="نام خانوادگی خود را وارد کنید"
                       class="form-input @((!ViewData.ModelState.IsValid && ViewData.ModelState["LastName"]?.Errors.Any() == true) ? "error" : "")"
                       required
                       autocomplete="family-name"
                       value="@Model?.LastName" />
            </div>
        </div>
    </div>

    <div class="form-group">
        <label for="username" class="form-label">
            <i class="fas fa-user-circle"></i>
            نام کاربری
        </label>
        <div class="input-container">
            <input type="text"
                   id="username"
                   name="UserName"
                   placeholder="نام کاربری دلخواه خود را وارد کنید"
                   class="form-input @((!ViewData.ModelState.IsValid && ViewData.ModelState["UserName"]?.Errors.Any() == true) ? "error" : "")"
                   required
                   autocomplete="username"
                   value="@Model?.UserName" />
        </div>
        <div class="hint-text">حداقل ۴ کاراکتر</div>
    </div>

    <div class="form-group">
        <label for="phone" class="form-label">
            <i class="fas fa-phone"></i>
            شماره تلفن
        </label>
        <div class="input-container">
            <input type="tel"
                   id="phone"
                   name="PhoneNumber"
                   placeholder="0912XXXXXXX"
                   class="form-input @((!ViewData.ModelState.IsValid && ViewData.ModelState["PhoneNumber"]?.Errors.Any() == true) ? "error" : "")"
                   autocomplete="tel"
                   value="@Model?.PhoneNumber" />
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="password" class="form-label">
                <i class="fas fa-lock"></i>
                کلمه عبور
            </label>
            <div class="input-container">
                <input type="password"
                       id="password"
                       name="Password"
                       placeholder="رمز عبور خود را وارد کنید"
                       class="form-input @((!ViewData.ModelState.IsValid && ViewData.ModelState["Password"]?.Errors.Any() == true) ? "error" : "")"
                       required
                       autocomplete="new-password" />
                <button type="button" class="toggle-password" onclick="togglePassword('password', this)">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <div class="hint-text">حداقل ۶ کاراکتر</div>
        </div>

        <div class="form-group">
            <label for="confirmPassword" class="form-label">
                <i class="fas fa-lock"></i>
                تأیید کلمه عبور
            </label>
            <div class="input-container">
                <input type="password"
                       id="confirmPassword"
                       name="ConfirmPassword"
                       placeholder="رمز عبور را مجدداً وارد کنید"
                       class="form-input @((!ViewData.ModelState.IsValid && ViewData.ModelState["ConfirmPassword"]?.Errors.Any() == true) ? "error" : "")"
                       required
                       autocomplete="new-password" />
                <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
        </div>
    </div>

    <button type="submit" class="cta-btn" id="registerBtn">
        <span class="btn-text">ثبت‌نام در سیستم</span>
        <i class="fas fa-user-plus btn-icon"></i>
    </button>

    <div class="loader" id="submitLoader">
        <div class="spinner"></div>
        <span>در حال ایجاد حساب کاربری...</span>
    </div>
</form>

@section Scripts {
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        document.getElementById('registerForm')?.addEventListener('submit', function(e) {
            const btn = document.getElementById('registerBtn');
            const loader = document.getElementById('submitLoader');

            btn.style.display = 'none';
            loader.classList.add('show');
        });
    </script>
}